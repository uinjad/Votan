# Copy this file to .env, or just fill these in from the admin panel
# (http://127.0.0.1:8080/admin.html) — the panel writes .env for you.
# Your real .env is gitignored and is never committed or shipped.

# OBS WebSocket (OBS -> Tools -> WebSocket Server Settings).
# Leave OBS_PASS blank to run without OBS.
OBS_ADDR=localhost:4455
OBS_PASS=

# YouTube live video id (the v= part of the watch URL).
# Leave blank to run without reading chat.
YOUTUBE_VIDEO_ID=

# Admin token: lets you issue !commands from chat as the operator.
# Pick something unguessable.
ADMIN_SECRET=

# Optional: override the listen address (default 127.0.0.1:8080, loopback only).
# LISTEN_ADDR=127.0.0.1:8080